# ============================================================================
#  Slay AI - 环境变量模板
#
#  使用方法:
#    1. 复制本文件为 .env         ->  copy .env.example .env
#    2. 把下面的占位值替换为真实配置
#    3. .env 已被 .gitignore 忽略, 请勿把真实密钥提交到仓库
#
#  配置由 app/core/config.py 统一读取, 代码中不散落 os.getenv。
# ============================================================================


# ---------------------------------------------------------------------------
# Qwen (通义千问) - 视觉识别 / Embedding / Rerank
# ---------------------------------------------------------------------------

# API Key。QWEN_API 为推荐拼写, QUEN_API 为兼容的历史拼写, 两者填一个即可。
QWEN_API=sk-your-qwen-api-key
# QUEN_API=sk-your-qwen-api-key

# Qwen OpenAI 兼容接口地址, 例如阿里云百炼:
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型: 负责把截图转成结构化 JSON
QWEN_VISION_MODEL=qwen3.7-flash

# 文本向量模型: RAG 语义召回使用
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# 重排模型: 对召回候选重新排序
QWEN_RERANK_MODEL=qwen3-rerank

# Rerank 完整接口地址。留空时自动使用 {QWEN_BASE_URL}/rerank
QWEN_RERANK_URL=

# 仅 scripts/describe_yiwu_images.py 等图片描述脚本使用, 可留空
QWEN_MODEL=


# ---------------------------------------------------------------------------
# DeepSeek - 推理决策模型
# ---------------------------------------------------------------------------

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_MODEL=deepseek-v4-flash


# ---------------------------------------------------------------------------
# 模型调用参数 (可选, 留空则使用默认值)
# ---------------------------------------------------------------------------

# 单次模型调用超时时间, 单位秒
MODEL_TIMEOUT_SECONDS=60

# 模型调用失败重试次数
MODEL_MAX_RETRIES=1


# ---------------------------------------------------------------------------
# MySQL - 卡牌 / 事件 / 药水 / 遗物 / 怪物 资料库
#
# 以下两套命名任选其一, 代码均已兼容:
#   方案 A: DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
#   方案 B: MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE
# ---------------------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=slay_ai_data

# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=slay_ai_data


# ---------------------------------------------------------------------------
# 数据采集脚本 (仅 scripts/crawl_*.py 需要)
# ---------------------------------------------------------------------------

# 灰机 wiki 浏览器 Cookie (杀戮尖塔中文 wiki)。
# 爬取脚本遇到 "访问被站点拒绝" 时, 通常是 Cookie 缺失或已过期。
HUIJI_COOKIE=

# 可选: 网络代理
# HTTP_PROXY=
# HTTPS_PROXY=
